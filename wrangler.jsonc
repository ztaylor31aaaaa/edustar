{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edustar",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./public/_worker.js"
}
